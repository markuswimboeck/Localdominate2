+      <BrandAnswersAr />
+      <LiveDemoAr />
+      <PageSectionsAr />
+      <PriceCardsAr />
+      <CreatorStepsAr />
+      <ComparisonAr />
+      <CreatorRulesAr />
+      <CreatorsFaqAr />
+      <MoreServicesAr />
+      <CreatorFormSectionAr />
+    </V4Page>
+  );
 }
