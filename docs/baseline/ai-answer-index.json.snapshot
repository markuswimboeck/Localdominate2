      "mainEntity": [
        {
          "@type": "Question",
          "name": "Öffnungszeiten, Feiertage und Sonderzeiten im Google-Unternehmensprofil",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tragen Sie im Unternehmensprofil die regulären Zeiten ein, zu denen Kunden Sie erreichen. Für Feiertage und Schließungen bis zu sechs Tagen nutzen Sie spezielle Öffnungszeiten, ab sieben Tagen den Status „vorübergehend geschlossen“. Saisonbetriebe tragen in der Saison reguläre Zeiten ein und sind außerhalb vorübergehend geschlossen. Hotels und Betriebe nur mit Termin geben laut Google keine Zeiten an.",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        },
        {
          "@type": "Question",
          "name": "Wie stelle ich ein, dass mein Betrieb rund um die Uhr geöffnet ist?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wählen Sie in den Öffnungszeiten bei jedem betroffenen Tag unter „Öffnet um“ die Option „24 Stunden“ und speichern Sie. Den Hinweis „24 Stunden geöffnet“ dürfen Sie nicht in den Firmennamen schreiben.",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        },
        {
          "@type": "Question",
          "name": "Wie lange darf eine Schließung mit speziellen Öffnungszeiten dauern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Höchstens sechs aufeinanderfolgende Tage. Ab sieben Tagen oder bei unbestimmter Dauer verlangt Google den Status „vorübergehend geschlossen“.",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        },
        {
          "@type": "Question",
          "name": "Muss ich Feiertage eintragen, an denen ich normal geöffnet habe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Google empfiehlt, die Zeiten für gesetzliche Feiertage auch dann zu bestätigen, wenn sie den regulären Zeiten entsprechen. Kunden sehen so, dass die Angabe für diesen Tag geprüft ist.",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        },
        {
          "@type": "Question",
          "name": "Schadet „vorübergehend geschlossen“ meinem Ranking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Google schreibt, dass vorübergehend geschlossene Betriebe bei allgemeinen Suchen hinter geöffneten Betrieben stehen können. Nutzen Sie den Status deshalb nur bei Schließungen ab sieben Tagen und setzen Sie ihn zur Wiedereröffnung sofort zurück.",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        },
        {
          "@type": "Question",
          "name": "Soll ein Hotel Öffnungszeiten angeben?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Google nennt Hotels und andere Unterkünfte ausdrücklich als Betriebe, die keine Öffnungszeiten angeben sollen. Rezeptionszeiten oder Check-in-Zeiten gehören auf die Website oder in die Buchungsbestätigung.",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        },
        {
          "@type": "Question",
          "name": "Warum zeigt Google andere Zeiten als die, die ich eingetragen habe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prüfen Sie zuerst, ob für den Tag spezielle Öffnungszeiten gelten, denn sie überschreiben die regulären Zeiten. Gleichen Sie dann Website, Markup und Verzeichnisse an, damit keine widersprüchlichen Angaben im Netz stehen, und korrigieren Sie Abweichungen direkt im Profil.",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        },
        {
          "@type": "Question",
          "name": "Wie soll „Öffnungszeiten, Feiertage und Sonderzeiten im Google-Unternehmensprofil” zitiert werden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "LocalDominate (2026-10-10). Öffnungszeiten, Feiertage und Sonderzeiten im Google-Unternehmensprofil. https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage",
            "url": "https://localdominate.org/blog/gbp-oeffnungszeiten-sondertage"
          }
        }
      ]
