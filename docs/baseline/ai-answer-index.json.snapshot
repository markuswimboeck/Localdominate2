      "mainEntity": [
        {
          "@type": "Question",
          "name": "Antworten auf Google-Bewertungen: Vorlagen für jede Situation",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eine gute Antwort auf eine Google-Bewertung ist kurz, freundlich und greift auf, was die Person geschrieben hat. Google rät zu persönlichen Antworten ohne Werbung, ohne private Daten und ohne Angriffe. Die Vorlagen unten decken die häufigsten Fälle ab, von fünf Sternen bis zur unfairen Kritik. Passen Sie jede an die konkrete Rezension an, bevor Sie sie veröffentlichen.",
            "url": "https://localdominate.org/blog/bewertungs-antworten-vorlagen"
          }
        },
        {
          "@type": "Question",
          "name": "Muss ich auf jede Google-Bewertung antworten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eine Pflicht gibt es nicht. Google beschreibt Antworten als Weg, zu zeigen, dass Sie das Feedback Ihrer Kunden schätzen, und rät, die Antworten dort zu setzen, wo sie etwas beitragen. Kritische Rezensionen sollten Sie nach unserer Einschätzung in jedem Fall beantworten, weil künftige Kunden Ihre Reaktion lesen.",
            "url": "https://localdominate.org/blog/bewertungs-antworten-vorlagen"
          }
        },
        {
          "@type": "Question",
          "name": "Warum erscheint meine Antwort nicht sofort?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Google prüft Antworten auf Einhaltung der Inhaltsrichtlinien. Laut Google dauert das meist bis zu 10 Minuten, in einigen Fällen bis zu 30 Tage. Wird eine Antwort nicht freigegeben, werden Sie gebeten, sie zu überarbeiten.",
            "url": "https://localdominate.org/blog/bewertungs-antworten-vorlagen"
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich meine Antwort später ändern oder löschen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Unter Ihrer Antwort finden Sie „Bearbeiten“ und „Löschen“. Das ist sinnvoll, wenn sich ein Problem geklärt hat oder die erste Antwort zu scharf war.",
            "url": "https://localdominate.org/blog/bewertungs-antworten-vorlagen"
          }
        },
        {
          "@type": "Question",
          "name": "Darf ich den Kunden in der Antwort mit Namen ansprechen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Google empfiehlt, die Person mit Namen anzusprechen. Verwenden Sie dafür nur den Namen, der in der Rezension angezeigt wird, meist den Vornamen. Praxen, Kanzleien und andere Berufsgeheimnisträger verzichten besser auf jede Anrede, die einen Kontakt bestätigt.",
            "url": "https://localdominate.org/blog/bewertungs-antworten-vorlagen"
          }
        },
        {
          "@type": "Question",
          "name": "Darf ich Antworten mit KI schreiben lassen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hinweise dazu haben wir in Googles Hilfe zu Antworten nicht gefunden. Unsere Einschätzung: Ein KI-Entwurf kann helfen, wenn ein Mensch ihn liest, das konkrete Detail ergänzt und prüft, dass keine persönlichen Daten enthalten sind.",
            "url": "https://localdominate.org/blog/bewertungs-antworten-vorlagen"
          }
        },
        {
          "@type": "Question",
          "name": "Wie soll „Antworten auf Google-Bewertungen: Vorlagen für jede Situation” zitiert werden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "LocalDominate (2026-10-13). Antworten auf Google-Bewertungen: Vorlagen für jede Situation. https://localdominate.org/blog/bewertungs-antworten-vorlagen",
            "url": "https://localdominate.org/blog/bewertungs-antworten-vorlagen"
          }
        }
      ]
